# Payment API - Environment Variables Template
# Copy this file to .env or set these in your Railway Variables panel.

# Port yang digunakan oleh Express. Di Railway, PORT akan diinject secara otomatis.
PORT=3000

# API Key rahasia untuk memverifikasi request dari aplikasi Sparkleen Laundry utama.
# PASTIKAN API_KEY INI SAMA dengan yang ada di file .env aplikasi CodeIgniter 4 Anda.
API_KEY=my-super-secret-key-123

# Lokasi penyimpanan database SQLite.
# Secara default 'data/database.sqlite'.
DB_FILE=data/database.sqlite

# Server-only HMAC key, separate from API_KEY; set the same value in Laundry.
# Never embed this in Smart Pay or Flutter. Blank disables callback-enabled payments.
PAYMENT_WEBHOOK_SECRET=
